# FindMYJob 环境变量模板（说明见 docs/ARCHITECTURE.md §6）
# 本地：由人执行 cp env.example .env 后填假值。AI 不读、不写任何 .env* 文件。
# 生产：值只放在主机的 /opt/findmyjob/env/*.env（权限 600、属主 deploy），不放 GitHub Secrets。
# 本文件只放占位值，不放任何真实密钥。

# production | staging | ci | development；生产判断只看它（DECISIONS A23）
APP_ENV=development
APP_URL=http://localhost:3000

# 数据库（角色见 ARCHITECTURE §5.10）
DATABASE_URL=postgresql://findmyjob_app:CHANGE_ME@127.0.0.1:5432/findmyjob?connection_limit=5
MIGRATE_DATABASE_URL=postgresql://findmyjob_owner:CHANGE_ME@127.0.0.1:5432/findmyjob
WORKER_DATABASE_URL=postgresql://findmyjob_app:CHANGE_ME@127.0.0.1:5432/findmyjob?connection_limit=3
SHADOW_DATABASE_URL=postgresql://findmyjob_owner:CHANGE_ME@127.0.0.1:5432/findmyjob_shadow
TEST_DATABASE_URL=postgresql://findmyjob_app:CHANGE_ME@127.0.0.1:5432/findmyjob_test?connection_limit=12
TEST_ADMIN_DATABASE_URL=postgresql://findmyjob_owner:CHANGE_ME@127.0.0.1:5432/findmyjob_test

# 认证
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# PII 密钥环：v1:<base64 32 字节>[,v2:...]；生成命令见 docs/RUNBOOK.md
PII_KEYS=
PII_ACTIVE_KEY_ID=v1

# Cloudflare Turnstile：开发环境用官方测试 key（总是通过；以 Cloudflare 文档为准）。APP_ENV=production 时禁止测试 key
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# 对象存储（本地 MinIO）
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=ap-southeast-5
S3_BUCKET=findmyjob-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 邮件：smtp | resend | ses
EMAIL_PROVIDER=smtp
EMAIL_FROM=FindMYJob <no-reply@example.test>
SMTP_URL=smtp://127.0.0.1:1025
RESEND_API_KEY=

# 监控
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
LOG_LEVEL=info

# Caddy 读取；E3 前改为 31536000
HSTS_MAX_AGE=300
# 镜像 tag（40 位 sha），由部署脚本写入
APP_TAG=

# 种子管理员（只在本地和 staging 用）
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=

# M9
ANTHROPIC_API_KEY=
AI_MODEL_PARSE=claude-haiku-5-5

# M8
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
