{
	admin off
}

{$APP_DOMAIN} {
	request_body {
		max_size 11MB
	}

	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp `\?.*` ""
				request>headers>Cookie delete
				request>headers>Authorization delete
			}
		}
	}
}
