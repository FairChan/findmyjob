{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": [
      "jest",
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@shared/*": [
        "../src/shared/*"
      ],
      "@messages/*": [
        "../messages/*"
      ],
      "zod": [
        "./node_modules/zod"
      ],
      "zod/*": [
        "./node_modules/zod/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../src/shared/**/*.ts"
  ]
}
